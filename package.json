{
  "name": "omnitrans",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "description": "One electron app which supports searching words anytime and anywhere.",
  "author": {
    "name": "MUGE_TONG",
    "email": "here5320@gmail.com"
  },
  "main": "out/main.js",
  "napi": {
    "binaryName": "rust",
    "targets": [
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "dev": "run-s build:rust watch:render",
    "watch:render": "vite",
    "build:render": "run-p type-check \"build:render-only {@}\" --",
    "build:render-only": "vite build",
    "build:rust": "napi build --cwd src-rust --package-json-path ../package.json --output-dir ../out/rust",
    "build:rust-release": "napi build --release --cwd src-rust --package-json-path ../package.json --output-dir ../out/rust",
    "build": "run-s build:rust-release build:render",
    "type-check": "vue-tsc --noEmit",
    "pack": "electron-builder --dir"
  },
  "build": {
    "appId": "com.nainote.omnitrans",
    "productName": "Omnitrans",
    "files": [
      "out/**",
      "package.json",
      "LICENSE",
      "README.md"
    ],
    "win": {
      "target": "nsis",
      "icon": "./public/logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "./public/logo.ico",
      "uninstallerIcon": "./public/logo.ico",
      "installerHeaderIcon": "./public/logo.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Omnitrans"
    }
  },
  "dependencies": {
    "axios": "^1.13.2",
    "pinia": "^3.0.4",
    "vue": "^3.5.26",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.3",
    "@types/electron": "^1.4.38",
    "@types/node": "^24.10.4",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/tsconfig": "^0.8.1",
    "electron": "^40.0.0",
    "npm-run-all2": "^8.0.4",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vue-tsc": "^3.2.2"
  }
}
